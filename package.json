{
  "name": "comi",
  "version": "0.1.0",
  "private": true,
  "description": "A pixel cat living in your GitHub profile README, fed by your GitHub activity.",
  "license": "MIT",
  "main": "dist/index.js",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@actions/core": "1.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "@vercel/ncc": "0.38.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
